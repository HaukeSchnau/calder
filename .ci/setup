#!/usr/bin/env bash
set -euo pipefail
: "${CI_CACHE_ROOT:?the workspace runner provides CI_CACHE_ROOT}"
key="$(cat pnpm-lock.yaml package.json packages/*/package.json sdk/package.json | sha256sum | cut -d' ' -f1)"
stamp="$CI_CACHE_ROOT/dependencies.sha256"
if [[ -f node_modules/.modules.yaml && -f "$stamp" && "$(<"$stamp")" == "$key" ]]; then
  echo "dependencies match ($key)"
  exit 0
fi
pnpm install --frozen-lockfile
printf '%s\n' "$key" > "$stamp"
