---
import "@fontsource-variable/instrument-sans/wdth.css"
import "@fontsource-variable/jetbrains-mono"
import "./site.css"

interface Props {
  readonly title: string
  readonly description: string
}

const { title, description } = Astro.props
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#f6f7f8" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="brand" href={base} aria-label="Calder, home">
        <span class="brand-lamp" aria-hidden="true"></span>
        Calder
      </a>
      <a class="open" href="/app/">Open the app</a>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <p>Calder is made by <a href="https://schnau.dev/">Hauke Schnau</a>.</p>
      <p><a href="https://schnau.dev/en/legal-notice/">Legal notice</a></p>
    </footer>
  </body>
</html>
