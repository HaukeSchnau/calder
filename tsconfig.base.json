{
  "extends": "@schnau/tsconfig/effect",
  "compilerOptions": {
    // Calder and every ci.ts run on Bun.
    "types": ["bun"],
    // Every project's ci.ts compiles against these types with it (sdk/tsconfig), and the API's
    // `Schema.optionalKey` fields reject an explicit `undefined`.
    "exactOptionalPropertyTypes": true,
    // The lint's effecttsgo rules report Effect's diagnostics. The patched tsrs would report each a
    // second time. Delete this list once @schnau/tsconfig 0.1.1, which turns them off, is out.
    "plugins": [{ "name": "@effect/language-service", "diagnostics": false }]
  }
}
