{
  "extends": "@schnau/tsconfig/effect",
  "compilerOptions": {
    // Calder and every ci.ts run on Bun.
    "types": ["bun"],
    // Every project's ci.ts compiles against these types with it (sdk/tsconfig), and the API's
    // `Schema.optionalKey` fields reject an explicit `undefined`.
    "exactOptionalPropertyTypes": true
  }
}
